<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.MediaLoader" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:fontFamily">sans</item>
    </style>
    <style name="Theme.MediaLoader" parent="Base.Theme.MediaLoader" />
    <!-- Only an Android share-intent trampoline; it does not show our main screen. -->
    <style name="Theme.MediaLoader.ShareReceiver" parent="android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>
</resources>
